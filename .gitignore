node_modules/
site/dist/
site/node_modules/
site/test-results/
site/playwright-report/
site/tests/snapshots/**/*.png

# Environment files (credentials, local paths)
.env
.env.local
*.env
!.env.example

# Kilo config with local paths (use kilo.json.example as template)
.kilo/kilo.json

# Playwright MCP browser artifacts (snapshots, console logs, screenshots)
.playwright-mcp/

# Kilo plan files (local development artifacts)
.kilo/plans/

# Thinker photos — large binary files, copied to VPS directly
Фото_мыслителей/

# Python bytecode (feedback microservice)
__pycache__/
*.pyc

# Local scratch. Only the A3 regeneration scripts stay tracked; screenshots,
# smoke output and review artifacts under .run/ are local-only.
.run/*
!.run/a3_*.py
!.run/a3_*.js

# Zed editor
.zed/
