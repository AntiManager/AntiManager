{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": "allow",
    "external_directory": {
      "C:\\Users\\{{USERNAME}}\\Documents\\Python\\AntiManager\\*": "allow",
      "C:\\Users\\{{USERNAME}}\\Documents\\{{VAULT_DIR}}\\*": "allow",
      "{{TEMP_DIR}}\\*": "allow"
    }
  },
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "--yes",
        "obsidian-mcp",
        "C:\\Users\\{{USERNAME}}\\Documents\\{{VAULT_DIR}}"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "--yes",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": true
    }
  },
  "snapshot": false
}
