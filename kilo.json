{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "small_model": "deepseek/deepseek-flash",
  "instructions": [
    ".kilo/AGENTS.md",
    ".memory/project_brief.md",
    ".memory/active_context.md",
    ".memory/progress.md"
  ],
  "permission": {
    "bash": "allow",
    "read": {
      ".env*": "deny",
      "**/.env*": "deny",
      "_private/**": "deny",
      "**/_private/**": "deny",
      "*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "edit": {
      ".env*": "ask",
      "**/.env*": "ask",
      ".git/**": "deny",
      "**/.git/**": "deny",
      "node_modules/**": "deny",
      "**/node_modules/**": "deny",
      "_private/**": "deny",
      "**/_private/**": "deny",
      "site/**": "allow",
      "*.md": "allow",
      "manifesto-*.md": "allow",
      ".kilo/**": "allow",
      ".memory/**": "allow",
      "*": "ask"
    },
    "webfetch": "allow",
    "task": "allow",
    "skill": "allow"
  },
  "snapshot": false
}
