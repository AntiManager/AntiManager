# AntiManager — окружение (скопируй в .env и заполни)
# Получить можно из Obsidian vault: VAULT_DIR/.kilo/globalsync.jsonc

# --- VPS (antimanager.pro) ---
REMOTE_USER=REMOTE_USER
REMOTE_HOST=ANTIMANAGER_VPS_IP
REMOTE_PORT=2222
REMOTE_DIR=/home/REMOTE_USER/antimanager

# --- Локальные пути ---
# Путь до Obsidian vault (где живут .md исходники глав)
VAULT_DIR=C:\Users\username\Documents\VAULT_DIR
# Путь до папки статей внутри vault
ARTICLES_DIR=C:\Users\username\Documents\VAULT_DIR\Книга\01_Статьи

# --- Поисковые системы (необязательно) ---
# Коды подтверждения из Яндекс.Вебмастера и Google Search Console.
# Если пусто — соответствующий meta-тег не выводится (заглушек в сборке нет).
YANDEX_VERIFICATION=
GOOGLE_VERIFICATION=
