# Copy to a server-side env file at $REMOTE_DIR/feedback.env (the REMOTE_DIR from
# your .env), fill in the real values, then chmod 600. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides.
PORT=8080
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=600
# TELEGRAM_API_BASE=https://api.telegram.org
